{
  "compilerOptions": {
    "strict": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "./src/",
    "types": ["node"],
    "skipLibCheck": true,
    "target": "ES2017",
    "lib": ["ESNext"],
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "./dist",
    "lib": ["ES2021", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*"]
}
